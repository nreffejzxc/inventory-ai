# Inventory AI — Mobile environment (Phase 05)
# Optional. Copy this file to `.env` to override the API base URL the app calls.
# `.env` is git-ignored; this file lists variable names only — never put
# credentials here. MongoDB credentials, JWT secrets and AI keys live only on
# the backend and are never compiled into the mobile app.

# Backend base URL, e.g. http://192.168.1.20:4000 for a physical device on your
# LAN. When unset the app falls back to the local dev defaults:
#   Android emulator -> http://10.0.2.2:4000
#   iOS simulator / web -> http://localhost:4000
EXPO_PUBLIC_API_URL=

# ---------------------------------------------------------------------------
# Firebase (Phase 32D)
# ---------------------------------------------------------------------------
# CLIENT configuration, not secrets. These are the Web App's public SDK config
# values from Firebase Console -> Project settings -> Your apps. They are inlined
# into the app bundle by design and are not credentials.
#
# All-or-nothing: Firebase stays disabled unless every one of these four is set.
# Phase 32D only establishes the SDK boundary, so leaving them empty (the default)
# changes nothing about how the app behaves.
#
# NEVER put the Firebase Admin SDK service account here — no private key, no
# client email, no FIREBASE_SERVICE_ACCOUNT_JSON. Those are server-only
# credentials (Phase 32B) and anything with an EXPO_PUBLIC_ prefix is compiled
# into the app bundle in plain text where any user can read it.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ---------------------------------------------------------------------------
# Google Sign-In (Phase 32I; native since Phase C, browser flow removed in Phase F1)
# ---------------------------------------------------------------------------
# CLIENT configuration, not secrets — the OAuth client IDs from Google Cloud
# Console → APIs & Services → Credentials. One per platform; the app picks the
# one for the running platform and falls back to the web client ID. These ship in
# the app bundle by design, exactly like the Firebase values above.
#
# THE CONSENT SHEET IS NATIVE. `@react-native-google-signin/google-signin` opens
# Google's own sheet and returns an `id_token`, which `lib/firebase-native.ts`
# exchanges for a Firebase credential and then for a Firebase ID token. The
# Authorization Code + PKCE browser round-trip was removed in Phase F1, so there is
# NO REDIRECT URI to register on these clients and no `googleRedirectUri()` helper.
#
# NEVER put a client SECRET here: the native flow needs no client secret, and anything
# with an EXPO_PUBLIC_ prefix is compiled into the bundle in plain text.
#
# NOTE: `expo.scheme` in app.json lists only `inventoryai` — the Phase 27 password-reset
# deep link `inventoryai://reset-password`, unrelated to Google. The retired OAuth redirect
# scheme was removed in Phase F2; native Google Sign-In needs no app scheme.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
