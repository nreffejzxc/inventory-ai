# Dependencies
node_modules/

# Environment — never commit secrets
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Expo / React Native build output
.expo/
dist/
web-build/
expo-env.d.ts

# Native project output (only created by `expo prebuild`; keep out of source control)
mobile/android/
mobile/ios/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor
.vscode/*
.idea/
*.swp

# Local tooling artifacts (Playwright MCP browser console/page captures)
.playwright-mcp/

# Local AI tooling state (Freebuff project/session metadata) — never commit.
# Until now this was protected by convention only ("stage by explicit path; never
# git add -A"), so a blanket stage would have committed it. This rule makes the
# boundary enforced rather than remembered.
.freebuff/

# Local editor/agent state (Claude Code local settings) — never commit.
# Previously ignored only by a MACHINE-LOCAL global excludes file
# (~/.config/git/ignore), so any other clone saw this file as untracked.
.claude/settings.local.json

# Local smoke-test artifacts (UIAutomator dumps, screenshots) — never commit
.smoke/

# Local device-verification scratch (screen captures, UIAutomator dumps, throwaway
# helper scripts) — never commit. Same category as .smoke/, kept separate so a
# verification run can be reviewed before it is thrown away.
.scratch/

# Imported chat attachments and one-off device-test captures — never commit.
.cloud-attachments/
.tmp-*
