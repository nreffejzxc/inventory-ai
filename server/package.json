{
  "name": "inventory-ai-server",
  "version": "0.1.0",
  "description": "Inventory AI backend REST API (Express, ES Modules)",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node src/index.ts",
    "dev": "node --watch src/index.ts",
    "test": "node scripts/run-tests.mjs full",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:db": "node scripts/run-tests.mjs db",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:extensions": "node scripts/check-module-graph.mjs extensions",
    "check:specifiers": "node scripts/check-module-graph.mjs specifiers",
    "cleanup": "node scripts/cleanup.mjs",
    "cleanup:test-firebase": "node scripts/cleanup-test-firebase.mjs",
    "audit:indexes": "node scripts/audit-indexes.mjs",
    "backup:db": "node scripts/backup-db.mjs",
    "restore:db": "node scripts/restore-db.mjs",
    "seed": "node scripts/seed.mjs",
    "seed:perf": "node scripts/seed-perf-data.mjs",
    "seed:perf-tenant": "node scripts/seed-perf-tenant.mjs",
    "seed:demo": "node scripts/seed-demo-account.mjs",
    "seed:demo-tenant": "node scripts/seed-demo-tenant.mjs",
    "seed:accounts": "node scripts/seed-accounts.mjs",
    "seed:three": "node scripts/seed-accounts.mjs --preset=three",
    "check:accounts": "node scripts/check-accounts.mjs",
    "seed:roles": "node scripts/seed-role-accounts.mjs",
    "cleanup:roles": "node scripts/cleanup-role-accounts.mjs",
    "verify:roles": "node scripts/verify-role-access.mjs",
    "verify:demo": "node scripts/verify-demo-data.mjs",
    "cleanup:perf": "node scripts/cleanup-perf-data.mjs",
    "cleanup:perf-tenant": "node scripts/cleanup-perf-tenant.mjs",
    "cleanup:demo-tenant": "node scripts/cleanup-demo-tenant.mjs",
    "cleanup:demo": "node scripts/cleanup-demo-account.mjs",
    "cleanup:account": "node scripts/cleanup-accounts.mjs",
    "cleanup:three": "node scripts/cleanup-accounts.mjs --preset=three",
    "ai:usage": "node scripts/ai-usage.mjs",
    "ai:check": "node scripts/check-ai-model.mjs",
    "ai:models": "node scripts/ai-models.mjs",
    "ai:health": "node scripts/ai-health-watch.mjs",
    "perf:measure": "node scripts/measure-ai-tools.mjs",
    "perf:golden": "node scripts/capture-ai-golden.mjs",
    "perf:turns": "node scripts/measure-ai-turns.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
