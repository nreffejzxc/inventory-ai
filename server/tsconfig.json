// TypeScript configuration (Phase TS-1).
//
// The server does NOT have a build step and this file does not add one:
// `noEmit` is set, so `tsc` is a *checker* here, never a compiler. The server
// keeps running its sources directly under Node's native type stripping
// (`node src/index.ts` from Phase TS-2F-p), which is why the flags below are
// chosen to keep the compiler and the runtime in exact agreement:
//
//   * `erasableSyntaxOnly`  — rejects precisely the syntax Node cannot strip
//                             (enum, runtime namespace, parameter properties,
//                             `import x = require()`), turning a runtime
//                             ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX into a compile
//                             error.
//   * `verbatimModuleSyntax` — forces `import type`, because a type imported
//                             without the keyword becomes a real runtime import
//                             of a binding that does not exist after stripping.
//   * `allowImportingTsExtensions` — required: specifiers name `.ts` explicitly,
//                             which is what Node's resolver needs. Legal only
//                             because `noEmit` is set.
//   * `module`/`moduleResolution: nodenext` — matches package.json's
//                             `"type": "module"` and enforces the
//                             extension-complete specifiers native ESM requires.
//
// Migration is incremental: `allowJs` keeps the un-migrated `.js` sources
// parsed and their exports inferred, while `checkJs: false` means they are
// never error-checked. New and migrated `.ts` files are fully strict.

{
  "compilerOptions": {
    "target": "ES2023",
    // TypeScript 6 + @types/node 26 resolves the global Console interface through
    // the DOM lib. This is type-only; the server still runs on Node.
    "lib": ["ES2023", "DOM"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "allowJs": true,
    "checkJs": false,
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,

    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "src/**/*.js", "test/**/*.mjs", "scripts/**/*.mjs"],
  "exclude": ["node_modules"]
}
